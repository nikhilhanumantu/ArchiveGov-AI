# =====================================================================
# ArchiveGov AI — Git Ignore Configuration
# =====================================================================

# Environment variables & secrets
.env
.env.local
.env.*.local

# Python caches & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc

# Virtual environments
env/
venv/
.venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*

# AI Checkpoint binaries (stored/downloaded separately)
ai_models/*.pth
ai_models/*.pt
ai_models/*.bin
ai_models/*.onnx
backend/weights/*.pth
backend/weights/*.pt

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE artifacts
.vscode/
.idea/
*.swp
*.swo
