# =====================================================================
# ArchiveGov AI — Environment Configuration Template
# Reviving Government History with Generative AI
# =====================================================================

# --- Application Core ---
APP_NAME="ArchiveGov AI — Government Records Restorer"
APP_VERSION="2.0.0"
ENV="development" # development | staging | production
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_NAME="archivegov_session"

# --- Database Configuration (MongoDB) ---
# Primary MongoDB Connection URI (e.g., MongoDB Atlas or local instance).
# If unreachable, the system automatically activates an embedded fallback engine.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/archivegov_db?retryWrites=true&w=majority"
DATABASE_NAME="archivegov_db"

# --- Archival File Storage Paths ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=50
MAX_IMAGE_DIMENSION=4096
TILE_SIZE=512

# --- AI & Neural Acceleration ---
# Device options: "cuda" (NVIDIA GPU), "mps" (Apple Silicon), or "cpu"
DEVICE="cpu"

# Custom model weight checkpoints (optional; falls back to high-fidelity CV filters if omitted)
# REALESRGAN_MODEL_PATH="backend/weights/RealESRGAN_x4plus.pth"
# LAMA_MODEL_PATH="backend/weights/big-lama.pt"
USE_PADDLE_OCR=false

# --- Generative AI & Enhancer APIs (Optional) ---
OPENROUTER_API_KEY=""
GOOGLE_AI_STUDIO_API_KEY=""
HF_TOKEN=""

# --- Outbound Email Relay (SMTP) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@archivegov.ai"

